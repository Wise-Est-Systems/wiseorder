# Copy to .env and fill in. Never commit .env.

# Database (matches docker-compose.yml ports)
WISEORDER_DATABASE_URL=postgresql+asyncpg://wiseorder:wiseorder@localhost:5433/wiseorder
WISEORDER_REDIS_URL=redis://localhost:6380/0

# Vector memory (embedded persistent ChromaDB)
WISEORDER_CHROMA_PATH=./data/chroma

# LLM — LiteLLM-compatible. Default uses Anthropic Claude.
# Set ONE provider key. LiteLLM picks the right transport from the model name.
WISEORDER_LLM_MODEL=claude-sonnet-4-6
ANTHROPIC_API_KEY=

# Optional providers (only set if you use them):
# OPENAI_API_KEY=
# GROQ_API_KEY=

# Approval delivery (pick one or leave both empty for file-only)
WISEORDER_DISCORD_WEBHOOK_URL=
WISEORDER_TELEGRAM_BOT_TOKEN=
WISEORDER_TELEGRAM_CHAT_ID=

# Repo watching — comma-separated absolute paths
WISEORDER_WATCH_PATHS=/Users/thekingflame/Desktop/wiseorder-protocol

# API server
WISEORDER_API_HOST=127.0.0.1
WISEORDER_API_PORT=8765

# Logging
WISEORDER_LOG_LEVEL=INFO
WISEORDER_LOG_DIR=./logs
