# .env.distribution.example
#
# Copy this file to `.env.distribution` and fill in real values. The real
# file is gitignored. Settings are merged with the main `.env` at startup.
#
# All variable names use the `WISEORDER_` prefix from configs/settings.py.
# Empty values are valid — the corresponding adapter will return success=False
# with an explicit "not configured" error when it tries to use them.

# --- LLM model for distribution drafts (falls back to WISEORDER_LLM_MODEL) ---
WISEORDER_DISTRIBUTION_DRAFTER_MODEL=claude-opus-4-7

# --- Hacker News adapter (Playwright-driven; HN has no submit API) ---
WISEORDER_HN_USERNAME=
WISEORDER_HN_PASSWORD=
# Run Playwright headless by default. Set to false to watch the submission flow.
WISEORDER_HN_PLAYWRIGHT_HEADLESS=true

# --- Email outreach adapter (SMTP send + IMAP reply-monitor) ---
WISEORDER_OUTREACH_SMTP_HOST=
WISEORDER_OUTREACH_SMTP_PORT=465
WISEORDER_OUTREACH_SMTP_USERNAME=
WISEORDER_OUTREACH_SMTP_PASSWORD=
WISEORDER_OUTREACH_FROM_ADDRESS=
WISEORDER_OUTREACH_IMAP_HOST=
WISEORDER_OUTREACH_IMAP_PORT=993
